#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
 mkdir -p /tmp/cudyroute /etc/cudyroute
 chmod 700 /tmp/cudyroute /etc/cudyroute
 [ -f /etc/cudyroute/settings.json ] || /usr/bin/cudyroute defaults > /etc/cudyroute/settings.json
 chmod 600 /etc/cudyroute/settings.json
 /usr/lib/cudyroute/network guard || return 1
 procd_open_instance
 procd_set_param command /usr/bin/cudyroute daemon
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 35
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger firewall network cudyroute
}
reload_service() {
 /usr/lib/cudyroute/network firewall
}
# stop service preserves the crash guard. Disable through LuCI to restore direct access.
